# 네이버클라우드 Maps > 등록한 Application > 인증 정보 > 키 ID (Client ID)
# Android 패키지명 / iOS Bundle ID는 app.config.ts와 동일해야 함: com.gilmoa.jejugilmoa
NAVER_MAP_CLIENT_ID=

# 웹뷰로 로드할 웹앱 배포 주소 (끝에 / 없이)
# 예: https://web.jejugilmoa.com 또는 http://192.168.0.10:5173
EXPO_PUBLIC_WEB_BASE_URL=https://web.jejugilmoa.com

# 백엔드 API origin (끝에 / 없이). 경로는 /api/... 를 붙인다.
EXPO_PUBLIC_API_BASE_URL=https://gilmoa-dev.gyeonseo.com

# 소셜 네이티브 (공개 키만). Secret은 앱에 넣지 않는다.
# 카카오 스킴: kakao{이 키}://oauth  — Android 키 해시는 콘솔에 아직 없음
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 구글 iOS 클라이언트 ID. Android는 SHA 지문 등록 전 공란
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 네이버 로그인 Client ID (콘솔 값). Android 패키지 / iOS scheme jejugilmoa
EXPO_PUBLIC_NAVER_CLIENT_ID=
